{
  "name": "@r2d2bzh/moleculer-mongo-checker",
  "version": "1.2.1",
  "description": "Checkers for moleculer-healthcheck-middleware to check liveness of Mongo",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "scripts": {
    "pretest": "npm install && docker compose up -d",
    "posttest": "docker compose down && npm run build:types",
    "test": "ava",
    "pretest:debug": "npm run pretest",
    "posttest:debug": "npm run posttest",
    "test:debug": "ava debug",
    "build:types": "tsc --declaration --allowJs --emitDeclarationOnly index.js",
    "release": "release-it"
  },
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@r2d2bzh/moleculer-healthcheck-middleware": "^2.2.0",
    "ava": "^6.4.1",
    "moleculer": "^0.14.35",
    "moleculer-db": "^0.8.29",
    "moleculer-db-adapter-mongo": "^0.4.21",
    "eslint": "^9.35.0",
    "@r2d2bzh/eslint-config": "^2.0.1",
    "typescript": "^5.9.2",
    "release-it": "^19.0.4",
    "@release-it/conventional-changelog": "^10.0.1"
  }
}
