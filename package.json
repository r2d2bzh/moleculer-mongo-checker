{
  "name": "@r2d2bzh/moleculer-mongo-checker",
  "version": "1.2.2",
  "description": "Checkers for moleculer-healthcheck-middleware to check liveness of Mongo",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "scripts": {
    "pretest": "npm install && docker compose up -d",
    "posttest": "docker compose down && npm run build:types",
    "test": "ava",
    "pretest:debug": "npm run pretest",
    "posttest:debug": "npm run posttest",
    "test:debug": "ava debug",
    "build:types": "tsc --declaration --allowJs --emitDeclarationOnly index.js",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r2d2bzh/moleculer-mongo-checker.git"
  },
  "bugs": {
    "url": "https://github.com/r2d2bzh/moleculer-mongo-checker/issues"
  },
  "homepage": "https://github.com/r2d2bzh/moleculer-mongo-checker#readme",
  "author": "",
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@r2d2bzh/eslint-config": "^3.0.1",
    "@r2d2bzh/moleculer-healthcheck-middleware": "^2.3.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "ava": "^8.0.1",
    "eslint": "^10.5.0",
    "moleculer": "^0.14.35",
    "moleculer-db": "^0.8.29",
    "moleculer-db-adapter-mongo": "^0.4.21",
    "release-it": "^20.2.0",
    "typescript": "^6.0.3"
  }
}
